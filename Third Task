import java.util.Scanner;

// Represents the user's bank account (Encapsulation)
class BankAccount {
    private double balance;

    public BankAccount(double initialBalance) {
        if (initialBalance < 0) {
            this.balance = 0.0;
        } else {
            this.balance = initialBalance;
        }
    }

    public double getBalance() {
        return balance;
    }

    public boolean deposit(double amount) {
        if (amount > 0) {
            balance += amount;
            return true;
        }
        return false;
    }

    public boolean withdraw(double amount) {
        if (amount > 0 && amount <= balance) {
            balance -= amount;
            return true;
        }
        return false;
    }
}

// Represents the ATM Interface connected to a BankAccount
public class ATM {
    private final BankAccount userAccount;
    private final Scanner scanner;

    public ATM(BankAccount account) {
        this.userAccount = account;
        this.scanner = new Scanner(System.in);
    }

    public void start() {
        boolean exit = false;
        System.out.println("=== Welcome to the Automated Teller Machine ===");

        while (!exit) {
            displayMenu();
            System.out.print("Choose an option (1-4): ");
            
            if (!scanner.hasNextInt()) {
                System.out.println("❌ Invalid input! Please enter a number between 1 and 4.");
                scanner.next(); // Clear invalid token
                continue;
            }

            int choice = scanner.nextInt();

            switch (choice) {
                case 1 -> checkBalance();
                case 2 -> handleDeposit();
                case 3 -> handleWithdrawal();
                case 4 -> {
                    exit = true;
                    System.out.println("\nThank you for using the ATM. Goodbye!");
                }
                default -> System.out.println("❌ Invalid selection! Please pick a choice from 1 to 4.");
            }
        }
        scanner.close();
    }

    private void displayMenu() {
        System.out.println("\n-----------------------------");
        System.out.println("1. Check Balance");
        System.out.println("2. Deposit");
        System.out.println("3. Withdraw");
        System.out.println("4. Exit");
        System.out.println("-----------------------------");
    }

    private void checkBalance() {
        System.out.printf("💰 Your current balance is: $%.2f%n", userAccount.getBalance());
    }

    private void handleDeposit() {
        System.out.print("Enter deposit amount: $");
        if (!scanner.hasNextDouble()) {
            System.out.println("❌ Invalid input! Amount must be a positive number.");
            scanner.next();
            return;
        }

        double amount = scanner.nextDouble();
        if (userAccount.deposit(amount)) {
            System.out.printf("✅ Successfully deposited $%.2f.%n", amount);
            checkBalance();
        } else {
            System.out.println("❌ Deposit failed! Amount must be greater than $0.");
        }
    }

    private void handleWithdrawal() {
        System.out.print("Enter withdrawal amount: $");
        if (!scanner.hasNextDouble()) {
            System.out.println("❌ Invalid input! Amount must be a positive number.");
            scanner.next();
            return;
        }

        double amount = scanner.nextDouble();
        if (amount <= 0) {
            System.out.println("❌ Withdrawal failed! Amount must be greater than $0.");
        } else if (amount > userAccount.getBalance()) {
            System.out.printf("❌ Transaction failed! Insufficient funds. Available balance: $%.2f%n", userAccount.getBalance());
        } else if (userAccount.withdraw(amount)) {
            System.out.printf("✅ Please collect your cash of $%.2f.%n", amount);
            checkBalance();
        }
    }

    public static void main(String[] args) {
        // Initialize user bank account with starting balance
        BankAccount account = new BankAccount(500.00);

        // Connect ATM to user account and start UI
        ATM atm = new ATM(account);
        atm.start();
    }
}
